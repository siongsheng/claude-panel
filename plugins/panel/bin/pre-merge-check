#!/usr/bin/env python3
"""Pre-merge remote-verification gate — prove the ref that MERGES is the ref
that was gated.

The panel verifies gates against the local working tree, then merges the remote
branch. Those are different states whenever a subagent commits without pushing —
and nothing in the loop compares them. A PR once merged INCOMPLETE this way: a
fix agent's commits existed only locally, `gh pr merge` squashed the stale remote
head, and the net-long safety fix was silently absent. Every local gate had
passed. It was caught only because a post-merge test count came back 763 instead
of 767.

This gate closes that window with checks that are all mechanical facts:

  PRE-MERGE (default):
    * SHA parity   — `git rev-parse HEAD` (local) == the remote branch head from
                     `git ls-remote`. A mismatch means unpushed local commits.
    * presence     — the fix's distinctive string is present on the REMOTE ref
                     (not the local file), and the old buggy line is GONE
                     (count 0). Presence of the new string does not prove the
                     old path is absent, so both are asserted.

  POST-MERGE (--post-merge):
    * count parity — re-run the suite on the pulled default branch and assert the
                     test count matches the branch's. A lower count means commits
                     were lost in the squash. This is the only cheap end-to-end
                     check that the thing reviewed is the thing merged.

Like `tdd-check`, every check is a fact, not a judgement, so a failure is a hard
fail (exit 1). The pure core is unit-tested; git/CI invocation is isolated.

Usage:
  pre-merge-check --branch <b> [--remote origin]
      [--present PATHSPEC NEEDLE]... [--absent PATHSPEC NEEDLE]...
  pre-merge-check --post-merge --expected-count N --count-cmd "<shell>"
      [--present PATHSPEC NEEDLE]... [--absent PATHSPEC NEEDLE]...
"""

import argparse
import dataclasses
import os
import re
import subprocess
import sys
from typing import List, Optional


# --------------------------------------------------------------------------
# Pure core
# --------------------------------------------------------------------------
@dataclasses.dataclass
class Check:
    name: str
    ok: bool
    detail: str


def parse_ls_remote(output: str, branch: str) -> Optional[str]:
    """Return the SHA `git ls-remote` reports for `branch`, else None.

    ls-remote lines are `<sha>\\t<ref>`. `branch` may be a short name
    (`feature/x`) or a full ref (`refs/heads/main`).
    """
    want = branch if branch.startswith("refs/") else f"refs/heads/{branch}"
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = re.split(r"\s+", line, maxsplit=1)
        if len(parts) != 2:
            continue
        sha, ref = parts[0], parts[1].strip()
        if ref == want:
            return sha
    return None


def sha_parity_check(local: str, remote: Optional[str]) -> Check:
    """Local HEAD must equal the remote branch head — else commits are unpushed."""
    ok = bool(remote) and local == remote
    if remote is None:
        detail = (f"local HEAD {local} but the branch has NO remote head "
                  f"(never pushed)")
    elif ok:
        detail = f"local == remote ({local})"
    else:
        detail = (f"local HEAD {local} != remote head {remote} — "
                  f"unpushed local commits would NOT merge")
    return Check("sha-parity", ok, detail)


def presence_check(label: str, count: int, must_be_present: bool) -> Check:
    """A grep count on a ref. must_be_present: count>0; else: count==0."""
    ok = (count > 0) if must_be_present else (count == 0)
    want = "present" if must_be_present else "absent (count 0)"
    detail = f"'{label}' expected {want}, found {count} match(es)"
    return Check(f"grep:{label}", ok, detail)


def count_parity_check(expected: int, actual: int) -> Check:
    """Test count on the merged default branch must equal the branch's count.

    A mismatch in EITHER direction means the merged state differs from what was
    gated (a lower count is dropped commits; a higher one is an unexpected
    divergence) — surface it, don't wave it through.
    """
    ok = expected == actual
    detail = (f"expected {expected} tests on the merged branch, ran {actual}"
              + ("" if ok else " — merged state differs from what was gated"))
    return Check("count-parity", ok, detail)


@dataclasses.dataclass
class PreMergeReport:
    checks: List[Check]

    @property
    def ok(self) -> bool:
        return all(c.ok for c in self.checks)

    @property
    def exit_code(self) -> int:
        return 0 if self.ok else 1


def build_report(checks: List[Check]) -> PreMergeReport:
    return PreMergeReport(checks=list(checks))


def render_report(report: PreMergeReport, annotate: bool = False) -> str:
    """Render the report. `annotate` emits GitHub `::error::` lines (CI only) —
    off by default because this is a supervisor-run tool, not a CI gate, and an
    idle annotation in a terminal log is just noise; the `[FAIL]` row already
    conveys the failure."""
    lines = ["pre-merge-check", "=" * 60]
    for c in report.checks:
        lines.append(f"  [{'ok' if c.ok else 'FAIL':>4}]  {c.name}: {c.detail}")
        if not c.ok and annotate:
            lines.append(
                f"::error title=Pre-merge check failed::{c.name}: {c.detail}")
    lines.append("-" * 60)
    lines.append("RESULT: PASS" if report.ok else "RESULT: FAIL")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Git / CI plumbing (impure)
# --------------------------------------------------------------------------
class GitError(Exception):
    """A git command failed. Surfaced as exit 2 — never folded into a check
    result, so an infrastructure failure (auth, network, bad ref) can NEVER
    masquerade as a passing check. That masquerade is the exact failure class
    this gate exists to catch, so its own plumbing must not commit it."""


def _run(cmd: List[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=False)


def _git_out(cmd: List[str]) -> str:
    """Run a git command that MUST succeed; return stdout, else raise GitError."""
    r = _run(cmd)
    if r.returncode != 0:
        raise GitError(f"`{' '.join(cmd)}` failed (rc={r.returncode}): "
                       f"{r.stderr.strip()}")
    return r.stdout


def _grep_count(ref: str, pathspec: str, needle: str) -> int:
    """`git grep -c` the needle on a ref, summed across files.

    git grep exit codes: 0 = matches, 1 = no matches, >=2 = ERROR. Only 0/1 are
    real answers; rc>=2 (bad ref/pathspec, corrupt object) must raise, NOT return
    0 — a silent 0 would pass an `--absent` check on a broken command.
    """
    r = _run(["git", "grep", "-c", "--fixed-strings", needle, ref, "--",
              pathspec])
    if r.returncode >= 2:
        raise GitError(f"`git grep` failed on {ref} (rc={r.returncode}): "
                       f"{r.stderr.strip()}")
    total = 0
    for line in r.stdout.splitlines():
        # format: ref:path:count
        m = re.search(r":(\d+)$", line.strip())
        if m:
            total += int(m.group(1))
    return total


def _pre_merge(args) -> PreMergeReport:
    checks: List[Check] = []
    local = _git_out(["git", "rev-parse", "HEAD"]).strip()
    ls = _git_out(["git", "ls-remote", args.remote, args.branch])
    remote = parse_ls_remote(ls, args.branch)
    checks.append(sha_parity_check(local, remote))

    if args.present or args.absent:
        # fetch MUST succeed — else the greps below would run against a stale
        # local ref and a failure could pass as verified (GitError -> exit 2).
        _git_out(["git", "fetch", args.remote, args.branch])
        # Grep the EXACT remote SHA from ls-remote, not the moving ref: binds
        # verification to the state that passed parity (no ls-remote/fetch race).
        # If the branch has no remote head, parity already failed — nothing to
        # anchor a grep to, so skip.
        if remote:
            for pathspec, needle in (args.present or []):
                checks.append(presence_check(
                    needle, _grep_count(remote, pathspec, needle),
                    must_be_present=True))
            for pathspec, needle in (args.absent or []):
                checks.append(presence_check(
                    needle, _grep_count(remote, pathspec, needle),
                    must_be_present=False))
    return build_report(checks)


def _post_merge(args) -> PreMergeReport:
    checks: List[Check] = []
    out = _run(["bash", "-lc", args.count_cmd]).stdout.strip()
    # The count-cmd must print the count as the last integer on its last line;
    # an unparseable result becomes -1 and FAILS parity (fails safe, loudly).
    m = re.search(r"\d+", out.splitlines()[-1] if out else "")
    actual = int(m.group(0)) if m else -1
    checks.append(count_parity_check(args.expected_count, actual))
    for pathspec, needle in (args.present or []):
        checks.append(presence_check(
            needle, _grep_count("HEAD", pathspec, needle), must_be_present=True))
    for pathspec, needle in (args.absent or []):
        checks.append(presence_check(
            needle, _grep_count("HEAD", pathspec, needle), must_be_present=False))
    return build_report(checks)


def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(prog="pre-merge-check", description=__doc__)
    ap.add_argument("--branch", help="the PR branch (short name or full ref)")
    ap.add_argument("--remote", default="origin")
    ap.add_argument("--present", nargs=2, action="append",
                    metavar=("PATHSPEC", "NEEDLE"),
                    help="assert NEEDLE is present in PATHSPEC on the ref "
                         "(works in both modes)")
    ap.add_argument("--absent", nargs=2, action="append",
                    metavar=("PATHSPEC", "NEEDLE"),
                    help="assert NEEDLE is absent (count 0) in PATHSPEC on the "
                         "ref (works in both modes)")
    ap.add_argument("--post-merge", action="store_true",
                    help="post-merge mode: assert test-count parity on HEAD")
    ap.add_argument("--expected-count", type=int,
                    help="(post-merge) the branch's test count. The --count-cmd "
                         "must print this as the last integer on its last line.")
    ap.add_argument("--count-cmd",
                    help="(post-merge) shell command printing the test count as "
                         "the last integer on its last line")
    args = ap.parse_args(argv)

    try:
        if args.post_merge:
            if args.expected_count is None or not args.count_cmd:
                ap.error("--post-merge requires --expected-count and --count-cmd")
            report = _post_merge(args)
        else:
            if not args.branch:
                ap.error("pre-merge mode requires --branch")
            report = _pre_merge(args)
    except GitError as exc:
        # A git command failed — exit 2 (distinct from a check FAIL), so an
        # infra failure is never mistaken for a verified state.
        msg = f"pre-merge-check: git error: {exc}"
        if os.environ.get("CI"):
            print(f"::error title=Pre-merge check::{exc}")
        print(msg, file=sys.stderr)
        return 2

    # CI annotations only when actually running in CI.
    print(render_report(report, annotate=bool(os.environ.get("CI"))))
    return report.exit_code


if __name__ == "__main__":
    sys.exit(main())
